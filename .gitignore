# ========================
# Root-level junk files
# (deps & config belong in Backend/ or FRONTEND/ only)
# ========================
/package.json
/package-lock.json
/node_modules/

# ========================
# Environment Variables
# ========================
.env
.env.*
!.env.example

# ========================
# Logs
# ========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# OS Files
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# Editor / IDE
# ========================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ========================
# Misc
# ========================
*.local
.cache/
.temp/
